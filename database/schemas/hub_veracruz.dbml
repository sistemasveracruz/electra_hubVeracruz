// -------- EDUCACIONAL ------- //

table edu_familias {
  cod_familia bigint [pk, not null]
  cod_pessoa bigint [not null, ref: > inst_pessoas.cod_pessoa]
  cod_pessoa_aluno bigint [not null, ref: > inst_pessoas.cod_pessoa]

  cod_parentesco bigint [not null, ref: > aux_parentesco.cod_parentesco] // ADD 13/11/2026
  parentesco varchar(25) [not null] // ADD 13/11/2026

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime

  Indexes {
    (cod_familia, cod_pessoa) [name: "ix_familias_pessoas_cod_familia_cod_pessoa"]
  }
}

table edu_responsaveis_financeiros {
  cod_responsavel_financeiro bigint [not null, pk, increment]
  cod_pessoa_aluno bigint [not null, ref: > inst_pessoas.cod_pessoa]
  cod_pessoa_responsavel bigint [not null, ref: > inst_pessoas.cod_pessoa]
  cod_parentesco_responsavel bingint [ref: ?>? aux_parentesco.cod_parentesco]
  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_responsaveis_pedagogico {
  cod_responsavel_pedagogico bigint [not null, pk, increment]
  cod_pessoa_aluno bigint [not null, ref: > inst_pessoas.cod_pessoa]
  cod_pessoa_responsavel bigint [not null, ref: > inst_pessoas.cod_pessoa]
  cod_parentesco_responsavel bingint [ref: ?>? aux_parentesco.cod_parentesco]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_responsaveis {
  cod_aluno bigint [not null, ref: > edu_alunos.cod_aluno]
  cod_pessoa_aluno bigint [not null, ref: > inst_pessoas.cod_pessoa]

  cod_responsavel_pedagogico bigint [not null, ref: > edu_responsaveis_pedagogico.cod_responsavel_pedagogico]
  cod_responsavel_financeiro bigint [not null, ref: > edu_responsaveis_financeiros.cod_responsavel_financeiro]

  created_at datetime
  updated_at datetime

  indexes {
    (cod_aluno, cod_responsavel_pedagogico, cod_responsavel_financeiro) [pk]
  }
}

table edu_tipo_cursos {
  cod_tipo_curso bigint [pk, not null]
  cod_escola bigint [not null, ref: > inst_escolas.cod_escola]
  nome varchar(150) [not null]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_cursos {
  cod_curso bigint [pk, not null]
  cod_escola bigint [not null, ref: > inst_escolas.cod_escola]
  nome varchar(150) [not null]
  sigla varchar(12)

  cod_tipo_curso bigint [not null, ref: > edu_tipo_cursos.cod_tipo_curso]
  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_etapas {
  cod_etapa bigint [not null]
  cod_curso bigint [not null, ref: > edu_cursos.cod_curso]
  nome varchar(150) [not null]
  sigla varchar(12)

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime

  indexes {
    cod_curso [name: "ix_etapas_cod_curso"]
    (cod_curso, cod_etapa) [unique, name: "uk_etapas_curso_codigo"]
  }
}

table edu_turnos {
  cod_turno bigint [pk, not null]
  nome varchar(80) [not null]
  sigla varchar(20)
}

table edu_periodos_letivos {
  cod_periodo_letivo bigint [pk, not null]
  cod_unidade_escolar bigint [not null, ref: > inst_unidades_escolares.cod_unidade_escolar]
  cod_tipo_curso bigint [not null, ref: > edu_tipo_cursos.cod_tipo_curso]

  cod_periodo_letivo_anterior bigint [null, ref: ?>? edu_periodos_letivos.cod_periodo_letivo]

  data_inicio datetime
  data_fim datetime
  data_estimada datetime

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_tipo_salas {
  cod_tipo_sala bigint [not null, pk]
  nome varchar(120) [not null]
  permite_reserva boolean [default: false, not null]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_salas {
  cod_sala bigint [not null, pk, increment]
  cod_unidade_escolar bigint [not null, ref: > inst_unidades_escolares.cod_unidade_escolar]
  cod_tipo_sala bigint [not null, ref: > edu_tipo_salas.cod_tipo_sala]

  nome varchar(120) [not null]
  descricao varchar(250) [null]
  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
  
  indexes {
    (cod_unidade_escolar, nome) [name: "ix_salas_cod_unidade_nome"]
  }
}

table edu_turmas {
  cod_turma bigint [pk, not null, increment]
  codigo_turma varchar(20) [not null]

  cod_unidade_escolar bigint [not null, ref: > inst_unidades_escolares.cod_unidade_escolar]
  cod_periodo_letivo bigint [not null, ref: > edu_periodos_letivos.cod_periodo_letivo]

  cod_curso bigint [not null, ref: > edu_cursos.cod_curso]
  cod_etapa bigint [not null, ref: > edu_etapas.cod_etapa]
  cod_sala bigint [ ref: ?>? edu_salas.cod_sala]
  cod_turno bigint [not null, ref: > edu_turnos.cod_turno]
  

  cod_pessoa_coordenador bigint [null, ref: ?>? inst_pessoas.cod_pessoa ]
  cod_pessoa_orientador bigint [null, ref: ?>? inst_pessoas.cod_pessoa ]
  cod_pessoa_professor_responsavel bigint [null, ref: ?>? inst_pessoas.cod_pessoa ]

  nome varchar(120) [not null]
  nome_reduzido varchar(12) [not null]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime

  indexes {
    (cod_periodo_letivo, codigo_turma, cod_etapa, cod_turno) [name: "ix_turmas_cod_periodo_letivo_codigo_turma_cod_etapa_cod_turno"]
  }
}

table edu_disciplinas {
  cod_disciplina bigint [pk, not null, increment]
  nome varchar(120) [not null]
  sigla varchar(30)
  observacoes varchar(250)

  ativo boolean [default: true, not null]
  
  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_turma_disciplinas {
  cod_turma_disciplina bigint [pk, not null]
  cod_turma bigint [not null, ref: > edu_turmas.cod_turma]
  cod_disciplina bigint [not null, ref: > edu_disciplinas.cod_disciplina]

  ativo boolean [default: true, not null]
  
  created_at datetime
  updated_at datetime
  deleted_at datetime

  indexes {
    (cod_disciplina, cod_turma) [unique]
  }
}

table edu_registros_academicos {
  cod_registro_academico bigint [pk, not null, increment]
  cod_pessoa bigint [not null, ref: > inst_pessoas.cod_pessoa]
  cod_escola bigint [not null, ref: > inst_escolas.cod_escola]

  registro_academico varchar(12) [not null]

  ativo boolean [default: true, not null]
  
  created_at datetime
  updated_at datetime
  deleted_at datetime

  Indexes {
    (cod_pessoa, registro_academico) [unique, name: "uq_registros_academicos_cod_escola_registro_academico"]
  }
}

table edu_matriculas {
  cod_matricula bigint [pk, not null, increment]
  
  cod_pessoa bigint [not null, ref: > inst_pessoas.cod_pessoa]
  cod_escola bigint [not null, ref: > inst_escolas.cod_escola]
  cod_unidade_escolar bigint [not null, ref: > inst_unidades_escolares.cod_unidade_escolar]
  
  cod_curso bigint [not null, ref: > edu_cursos.cod_curso]
  cod_etapa bigint [not null, ref: > edu_etapas.cod_etapa]
  cod_turma bigint [not null, ref: > edu_turmas.cod_turma]

  cod_status bigint [not null, ref: > edu_status.cod_status]

  cod_registro_academico bigint [not null, ref: > edu_registros_academicos.cod_registro_academico]
  

  ativo boolean [default: true, not null]
  
  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_alunos {
  cod_aluno bigint [pk, not null, increment]
  cod_pessoa bigint [not null, ref: > inst_pessoas.cod_pessoa]
  
  cod_registro_academico bigint [not null, ref: > edu_registros_academicos.cod_registro_academico]
  cod_matricula bigint [not null, ref: > edu_matriculas.cod_matricula]
  
  cod_pessoa_pai bigint [ref: ?>? inst_pessoas.cod_pessoa]  // ADD 13/11/2026
  cod_pessoa_mae bigint [ref: ?>? inst_pessoas.cod_pessoa]// ADD 13/11/2026
  cod_pessoa_responsavel_pedagogico bigint [ref: ?>? inst_pessoas.cod_pessoa]// ADD 13/11/2026
  cod_pessoa_responsavel_financeiro bigint [ref: ?>? inst_pessoas.cod_pessoa]// ADD 13/11/2026

  ativo boolean [default: true, not null]
  
  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_enturmas {
  cod_enturma bigint [pk, not null, increment]
  cod_aluno bigint [not null, ref: > edu_alunos.cod_aluno]
  cod_matricula bigint [not null, ref: > edu_matriculas.cod_matricula]
  cod_turma bigint [not null, ref: > edu_turmas.cod_turma]
  cod_status bigint [not null, ref: > edu_status.cod_status]

  numero_chamada varchar(120)

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime

  indexes {
    (cod_matricula, cod_turma) [name: "ix_enturmas_cod_matricula_cod_turma"]
    (cod_enturma, cod_matricula) [unique, name: "uq_enturmas_cod_enturma_cod_matricula"]
  }
}

table edu_status {
  cod_status bigint [pk, not null]
  nome varchar(120) [not null]
  descricao varchar(250)

  ativo boolean [default: true, not null]
  
  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_grades_curriculares {
  cod_grade_curricular bigint [pk, not null, increment]
  cod_grade varchar(20) [not null]
  cod_curso bigint [not null, ref: > edu_cursos.cod_curso]
  cod_etapa bigint [not null, ref: > edu_etapas.cod_etapa]
  descricao varchar [not null]

  data_inicio datetime
  data_fim datetime

  carga_horaria decimal (10,2)

  ativo boolean [default: true, not null]
  
  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table edu_grade_curricular_disciplinas {
  cod_grade_disciplina bigint [pk, not null, increment]
  cod_grade_curricular bigint [not null, ref: > edu_grades_curriculares.cod_grade_curricular]
  
  cod_etapa BIGINT [not null, ref: > edu_etapas.cod_etapa]
  cod_curso BIGINT [not null, ref: > edu_cursos.cod_curso]
  cod_disciplina BIGINT [not null, ref: > edu_disciplinas.cod_disciplina]
  
  // cod_turno bigint [ref: ?>? edu_turnos.cod_turno] // não foi encontrado o cod turno
  periodo_grade varchar(30)

  aulas_semanais decimal (8,2)
  // quantidade_semanas decimal (8,2)
  carga_horaria decimal (10,2)
  obrigatoria boolean [default: true, not null]
  
  indexes {
    // (cod_grade_disciplina, cod_etapa, cod_disciplina, cod_turno, periodo_grade) [name: "ix_grades_disciplinas_cod_grade_cod_etapa_cod_discipli_d69ac9c5"]
    (cod_grade_disciplina, cod_etapa, cod_disciplina, periodo_grade) [name: "ix_grades_disciplinas_cod_grade_cod_etapa_cod_discipli_d69ac9c5"]
  }
}

table edu_aplicacoes_curriculares {
  cod_aplicacao_curricular bigint [pk, not null]
  cod_grade_curricular bigint [not null, ref: > edu_grades_curriculares.cod_grade_curricular]
  cod_unidade_escolar bigint [ref: ?>? inst_unidades_escolares.cod_unidade_escolar ]
  cod_etapa bigint [ref: ?>? edu_etapas.cod_etapa]
  cod_turno bigint [ref: ?>? edu_turnos.cod_turno]

  regime_grade varchar(30)
  periodo_grade varchar(30)

  data_inicio datetime
  data_fim datetime

  indexes {
    (cod_grade_curricular, cod_unidade_escolar, cod_etapa, cod_turno) [name: "ix_aplicacoes_curriculares_cod_grade_cod_unidade_cod_e_0c1f2a72"]
  }
}

// ----- FIM EDUCACIONAL ----- //
