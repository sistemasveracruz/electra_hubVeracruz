
// ----- BASE DO BANCO ----- //
table inst_escolas {
  cod_escola bigint [pk, not null]
  nome varchar(150) [not null]
  nome_fantasia varchar(150)
  cnpj varchar(14) [not null]
  descricao varchar(250)

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table inst_unidades_escolares {
  cod_unidade_escolar bigint [pk, not null]
  cod_escola bigint [not null, ref: > inst_escolas.cod_escola]
  nome varchar(150) [not null]
  sigla varchar(20)
  descricao varchar(250)

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}


table inst_pessoas {
  cod_pessoa bigint [pk, not null]
  cpf varchar(11) [not null, unique]
  nome varchar(150) [not null]
  data_nascimento date
  email varchar(250)
  email_pessoal varchar(250) 
  email_alternativo varchar(250) 

  telefone_fixo VARCHAR(20)
  telefone_pessoal VARCHAR(20)
  telefone_empresa VARCHAR(20)

  falecido boolean [default: true, not null]
  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime

  indexes { (cpf, cod_pessoa) }
}


enum enum_tipo_endereco {
  PESSOAL
  EMPRESARIAL
  CORRESPONDENCIA
}

enum enum_tipo_professor {
  J [note: 'Adjunto']
  I [note: 'Assistente']
  X [note: 'Auxiliar']
  D [note: 'Coordenador']
  C [note: 'Colaborador']
  P [note: 'Conteudista']
  E [note: 'Diretor de Turma']
  Q [note: 'Mediador pedagógico']
  M [note: 'Monitor']
  N [note: 'Não docente']
  R [note: 'Orientador']
  O [note: 'Outros']
  S [note: 'Substituto']
  T [note: 'Titular']
  U [note: 'Tutor']
}

table aux_tipo_endereco {
  cod_tipo_endereco bigint [pk, not null]
  descricao varchar [not null]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}


table inst_pessoa_enderecos {
  cod_pessoa_endereco bigint [pk, not null, increment]
  cod_pessoa bigint [not null, ref: > inst_pessoas.cod_pessoa]

  tipo_endereco enum_tipo_endereco  [not null]
  cep varchar(8)
  logradouro varchar(200)
  numero varchar(20)
  complemento varchar(100)
  bairro varchar(100)
  cidade varchar(100)
  uf char(2)

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime

  indexes {
    cod_pessoa [name: "ix_pessoa_enderecos_cod_pessoa"]
    (cod_pessoa, tipo_endereco)
  }
}

// ADD 07/11
table inst_secoes {
  cod_secao varchar(20) [pk, not null]
  descricao varchar(150) [not null]

  cod_secao_pai varchar(20) [null, ref: ?>? inst_secoes.cod_secao]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

// ----- FIM BASE DO BANCO ----- //
// ==============================//
// -------- FUNCIONARIOS ------- //

// TABELA ADD 07/11
table fun_situacao {
  cod_fun_situacao char(1) [pk, not null]
  descricao varchar(150) [not null]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

// TABELA ADD 07/11
table fun_funcoes {
  cod_funcao varchar(20) [pk, not null]
  nome varchar(150) [not null]
  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

table fun_funcionarios {
  cod_funcionario bigint [pk, increment]
  chapa varchar(20) [not null, unique] // ADD 07/11
  cod_pessoa bigint [not null, ref: > inst_pessoas.cod_pessoa]
  tipo_cadastro VARCHAR(30) [not null, default: 'PESSOA']

  cod_secao varchar(20) [not null, ref: > inst_secoes.cod_secao] // ADD 07/11
  cod_funcao varchar(20) [not null, ref: > fun_funcoes.cod_funcao] // ADD 07/11
  cod_fun_situacao char(1) [not null, ref: > fun_situacao.cod_fun_situacao] // ADD 07/11

  // REMOVIDO 07/11
  // professor_cadastro boolean [default: false, not null]

  data_admissao datetime // ADD 07/11
  data_desligamento datetime // ADD 07/11

  ativo boolean [default: true, not null] // PFUNC.CODSITUACAO IN ('A', 'E', 'F', 'G', 'W', 'Y') = TRUE SE NÃO FALSE 

  created_at datetime
  updated_at datetime
  deleted_at datetime

  Indexes {
    (cod_pessoa, chapa) 
  }
}

// TABELA ADD 07/11
table fun_professores {
  cod_professor bigint [pk, not null] // SPROFESSOR.CODPROF
  cod_pessoa bigint [not null, ref: > inst_pessoas.cod_pessoa] 
  chapa varchar(20) [not null, ref: > fun_funcionarios.chapa]
  
  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

// TABELA ADD 07/11
table fun_professor_disciplinas {
  cod_professor_disciplina bigint [pk, increment] // APENAS PARA CONSULTAS INTERNAS SEM RELACAO TOTVS
  cod_disciplina bigint [not null, ref: > edu_disciplinas.cod_disciplina] 
  cod_professor bigint  [not null, ref: > fun_professores.cod_professor]
  
  cod_turma bigint [not null, ref: > edu_turmas.cod_turma]
  tipo_professor char(1)

   
  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}



