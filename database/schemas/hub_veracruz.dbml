// ------- AUXIALIARES ------- //

table aux_parentesco {
  cod_parentesco bigint [pk, not null, increment]
  descricacao varchar [not null]

  ativo boolean [default: true, not null]

  created_at datetime
  updated_at datetime
  deleted_at datetime
}

// ----- FIM AUXIALIARES ----- //
// =========================== //
// ------- DOCUMENTACAO ------ //

table doc_prefixos {
  cod_prefixo bigint [pk, not null]
  sigla char(6) [not null, unique]
  descricao varchar(250)
}

// matriculas_disciplinas não encontrei necesidade para essa tabela, já que ele é matriculado no curso e curso tem as diciplinas



// ------- VIEWS ------- //
// vw_login_pessoas (ADD 20/11/2026): uma linha por CPF com o que o login do appapi usa
// (identidade, vínculos, cod_cursos/cod_alunos/ensinos e as flags de available_options).
// Fonte: database/scripts/views/vw_login_pessoas.sql
